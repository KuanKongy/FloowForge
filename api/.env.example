# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Redis Streams job queue. When unreachable the API falls back to executing
# runs inline in its own process (capped concurrency) and keeps retrying.
REDIS_URL=redis://localhost:6379/0

# "development" additionally trusts localhost for CORS and allows outgoing
# webhook callbacks to private addresses. Leave as "production" when deployed.
ENVIRONMENT=development

# Encrypts per-user provider credentials at rest (integrations table).
# Required to create integrations. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotating this makes existing stored credentials unreadable.
CREDENTIALS_KEY=

# Default provider keys (overridden per-user via the integrations table)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_KEY=
CLOUDFLARE_ID=
CLOUDFLARE_KEY=

# CORS / public URLs. WEB_ORIGIN accepts a comma-separated list.
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:5001
