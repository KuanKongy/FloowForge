# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Redis Streams job queue. When unreachable the API falls back to executing
# runs inline in its own process (capped concurrency) and keeps retrying.
REDIS_URL=redis://localhost:6379/0

# "development" additionally trusts localhost for CORS and allows outgoing
# webhook callbacks to private addresses. Leave as "production" when deployed.
ENVIRONMENT=development

# Encrypts per-user provider credentials at rest (integrations table).
# Required to create integrations. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Rotating this makes existing stored credentials unreadable.
CREDENTIALS_KEY=

# Default provider keys (overridden per-user via the integrations table)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_KEY=
CLOUDFLARE_ID=
CLOUDFLARE_KEY=

# CORS / public URLs. WEB_ORIGIN accepts a comma-separated list.
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:5001

# --- Rate limiting (defaults are fine for most deployments) ---------------
# RATE_LIMIT_ENABLED=true
# Number of trusted reverse proxies in front of the API (0 = trust only the
# socket peer; N = read the Nth-from-the-right X-Forwarded-For hop).
# TRUSTED_PROXY_HOPS=0
# Per-identity default per minute (user > device fingerprint > IP).
# RL_GLOBAL_PER_MIN=300
# Flood ceiling per IP per minute (shared by everyone behind a campus NAT).
# RL_IP_PER_MIN=1200
# Hourly cap on run creation per account.
# RL_RUNS_PER_HOUR=500
# Client-signal event log (IP, fingerprint, OS/browser, timezone, language)
# persisted to the client_events table for abuse forensics; retained 90 days.
# CLIENT_EVENTS_ENABLED=true
# CLIENT_EVENT_SAMPLE_RATE=0.1
