# Browser-side build args for the `web` image (docker compose reads this file).
# Copy the values from web/.env — the public Supabase project URL and anon key,
# both safe to expose to the browser. Backend secrets live in api/.env.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
